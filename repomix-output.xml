                  Închide
                </button>
              ) : (
                <>
                  <button onClick={inchideModal} style={{ padding: '8px 14px', fontSize: 18, color: 'rgba(255,255,255,0.4)', background: 'none', border: 'none', cursor: 'pointer', fontFamily: "'DM Sans', sans-serif" }}>Anulează</button>
